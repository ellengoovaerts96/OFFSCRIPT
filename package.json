    "logic:check": "tsx scripts/checkLogic.ts",
    "search-profile:check": "tsx scripts/checkSearchProfile.ts",
    "activity-intent:check": "node --import tsx scripts/checkActivityIntent.ts",
    "live-music-intent:check": "node --import tsx scripts/checkLiveMusicIntent.ts",
    "semantic-routing:check": "node --import tsx scripts/checkSemanticRouting.ts",
    "breakfast-matching:check": "node --import tsx scripts/checkBreakfastMatching.ts",
    "meal-clarification:check": "node --import tsx scripts/checkMealClarification.ts",
    "social-link:check": "node --import tsx scripts/checkSocialLink.ts",
    "recommendation-feedback:check": "node --import tsx scripts/checkRecommendationFeedback.ts",
    "conversation:check": "tsx scripts/checkRealConversations.ts",
    "whatsapp-deadline:check": "node --experimental-vm-modules scripts/checkWhatsAppDeadline.mjs",
    "source-tracking:check": "node --import tsx scripts/checkSourceTracking.ts",
    "sources-admin:check": "node --import tsx scripts/checkSourcesAdmin.ts",
    "dashboard:check": "node --import tsx scripts/checkDashboard.ts",
    "places-admin:check": "node --import tsx scripts/checkPlacesAdmin.ts",
    "editorial-locks:check": "node --import tsx scripts/checkEditorialLocks.ts",
    "place-photo-admin:check": "node --import tsx scripts/checkPlacePhotoAdmin.ts",
    "place-video-admin:check": "node --import tsx scripts/checkPlaceVideoAdmin.ts",
    "place-dishes:check": "node --import tsx scripts/checkPlaceDishes.ts",
    "field-notes-assessment:check": "node --import tsx scripts/checkFieldNotesAssessment.ts",
    "ai:check": "tsx scripts/checkAI.ts",
    "build": "tsc",
    "start": "node dist/migrate.js && node dist/server.js",
    "event-import:check": "node --import tsx scripts/checkEventImport.ts",
    "published-events:check": "node --import tsx scripts/checkPublishedEvents.ts",
    "event-persistence:check": "node --experimental-vm-modules --import tsx scripts/checkEventPersistence.mjs",
    "event-recurrence:check": "node --import tsx scripts/checkEventRecurrence.ts",
    "event-location:check": "node --import tsx scripts/checkEventLocationLookup.ts && node --experimental-vm-modules --import tsx scripts/checkEventLocationService.mjs",
    "event-translation:check": "node --experimental-vm-modules --import tsx scripts/checkEventTranslation.mjs",
    "field-research:check": "node --experimental-vm-modules --import tsx scripts/checkFieldResearch.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cloudinary": "^2.11.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^173.0.0",
    "multer": "^2.4.0",
    "openai": "^6.38.0",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "twilio": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.8.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3"
  }
