{
  "name": "offscript",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "sync:field-research": "node --import tsx scripts/syncFieldResearch.ts",
    "sync:places": "tsx scripts/syncPlacesFromRaw.ts",
    "sync:contacts": "node --import tsx scripts/syncContactsFromRaw.ts",
    "sync:place-images": "node --import tsx scripts/syncPlaceImagesFromRaw.ts",
    "sync:place-coordinates": "node --import tsx scripts/syncPlaceCoordinates.ts",
    "setup:editorial-sheet": "tsx scripts/setupEditorialRankingSheet.ts",
    "setup:field-notes-sheet": "tsx scripts/processFieldNotes.ts --headers-only",
    "setup:field-notes-form": "node --import tsx scripts/updateFieldNotesForm.ts",
    "rename:field-notes-branding": "node --experimental-strip-types scripts/renameFieldNotesBranding.ts",
    "process:field-notes": "tsx scripts/processFieldNotes.ts",
    "sync:structured-import": "node --import tsx scripts/syncStructuredImport.ts",
    "sync:editorial-ranking": "node --import tsx scripts/syncEditorialRanking.ts",
